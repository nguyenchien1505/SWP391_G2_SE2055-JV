# Mẫu file .env — copy thành "backend/.env" rồi điền giá trị thật.
# File .env đã nằm trong .gitignore: KHÔNG commit giá trị thật lên git.

# ── MySQL ────────────────────────────────────────────────────────────────────
DB_USERNAME=root
DB_PASSWORD=

# ── Google OAuth2 (đăng nhập bằng Google) ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email gửi mật khẩu tạm khi tạo / cấp lại mật khẩu tài khoản (TÙY CHỌN) ────
# Mặc định TẮT. Muốn bật: đặt MAIL_ENABLED=true và điền 2 dòng dưới.
# MAIL_USERNAME: địa chỉ Gmail dùng để gửi.
# MAIL_PASSWORD: App Password 16 ký tự (KHÔNG phải mật khẩu Gmail thường) — tạo tại
#   https://myaccount.google.com/apppasswords sau khi bật xác minh 2 bước.
MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=
