        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    TENANT ||--|| SUBSCRIPTION : \&quot;has current\&quot;\n    TENANT ||--o{ INVOICE : \&quot;has\&quot;\n    SUBSCRIPTION ||--o{ INVOICE : \&quot;generates\&quot;\n    PRICING_CONFIG ||--o{ SUBSCRIPTION : \&quot;logical reference\&quot;\n\n    TENANT ||--o{ LOCATION : \&quot;owns\&quot;\n    TENANT ||--o{ DEPARTMENT : \&quot;defines\&quot;\n    TENANT ||--o{ POSITION : \&quot;defines\&quot;\n    TENANT ||--o{ ROOM_TYPE : \&quot;defines\&quot;\n    TENANT ||--o{ ASSET_CATEGORY : \&quot;defines\&quot;\n    TENANT ||--o{ USER : \&quot;contains\&quot;\n\n    TENANT ||--|| SCHEDULE_POLICY : \&quot;has\&quot;\n    TENANT ||--o{ SHIFT_TEMPLATE : \&quot;defines\&quot;\n    TENANT ||--o{ TRANSFER_REQUEST : \&quot;has\&quot;\n\n    DEPARTMENT ||--o{ POSITION : \&quot;contains\&quot;\n    POSITION ||--o{ USER : \&quot;assigned to\&quot;\n    LOCATION ||--o{ USER : \&quot;assigned to\&quot;\n\n    LOCATION ||--o{ AREA : \&quot;has\&quot;\n    LOCATION ||--o{ ROOM : \&quot;has\&quot;\n    LOCATION ||--o{ SHIFT : \&quot;has\&quot;\n    LOCATION ||--o{ LEAVE_REQUEST : \&quot;has\&quot;\n    LOCATION ||--o{ SHIFT_SWAP_REQUEST : \&quot;has\&quot;\n    LOCATION ||--o{ FIXED_ASSET : \&quot;has\&quot;\n    LOCATION ||--o{ CONSUMABLE_ITEM : \&quot;has\&quot;\n\n    ROOM_TYPE ||--o{ ROOM : \&quot;categorizes\&quot;\n    ROOM ||--o{ ROOM_STATUS_HISTORY : \&quot;has\&quot;\n    ROOM ||--o{ HOUSEKEEPING_TASK : \&quot;has\&quot;\n    ROOM ||--o{ FIXED_ASSET : \&quot;contains\&quot;\n    AREA ||--o{ FIXED_ASSET : \&quot;contains\&quot;\n\n    SHIFT_TEMPLATE ||--o{ SHIFT : \&quot;used by\&quot;\n    USER ||--o{ SHIFT : \&quot;assigned to\&quot;\n    USER ||--o{ LEAVE_REQUEST : \&quot;requests\&quot;\n    USER ||--o{ LEAVE_REQUEST : \&quot;reviews\&quot;\n    USER ||--o{ SHIFT_SWAP_REQUEST : \&quot;staff A\&quot;\n    USER ||--o{ SHIFT_SWAP_REQUEST : \&quot;staff B\&quot;\n    USER ||--o{ SHIFT_SWAP_REQUEST : \&quot;reviews\&quot;\n    SHIFT ||--o{ SHIFT_SWAP_REQUEST : \&quot;shift A\&quot;\n    SHIFT ||--o{ SHIFT_SWAP_REQUEST : \&quot;shift B\&quot;\n\n    USER ||--o{ TRANSFER_REQUEST : \&quot;creates\&quot;\n    USER ||--o{ TRANSFER_REQUEST : \&quot;target\&quot;\n    USER ||--o{ TRANSFER_REQUEST : \&quot;replacement\&quot;\n    USER ||--o{ TRANSFER_REQUEST : \&quot;approves\&quot;\n    USER ||--o{ HOUSEKEEPING_TASK : \&quot;assigned to\&quot;\n    USER ||--o{ INSPECTION_RECORD : \&quot;performs\&quot;\n    USER ||--o{ DAMAGE_REPORT : \&quot;reports\&quot;\n    USER ||--o{ ROOM_STATUS_HISTORY : \&quot;performs\&quot;\n\n    HOUSEKEEPING_TASK ||--o{ HOUSEKEEPING_TASK : \&quot;parent task\&quot;\n    HOUSEKEEPING_TASK ||--o{ INSPECTION_RECORD : \&quot;has\&quot;\n    HOUSEKEEPING_TASK ||--o{ ROOM_STATUS_HISTORY : \&quot;causes\&quot;\n\n    ASSET_CATEGORY ||--o{ FIXED_ASSET : \&quot;categorizes\&quot;\n    ASSET_CATEGORY ||--o{ CONSUMABLE_ITEM : \&quot;categorizes\&quot;\n    FIXED_ASSET ||--o{ DAMAGE_REPORT : \&quot;has\&quot;\n\n    TENANT {\n        uuid id PK\n        string name\n        string contact_email UK\n        enum status\n        enum suspend_reason\n        datetime suspended_at\n        datetime reactivated_at\n    }\n\n    SUBSCRIPTION {\n        uuid id PK\n        uuid tenant_id FK_UK\n        int quota_location\n        int quota_user\n        int quota_room\n        decimal price_per_location\n        decimal price_per_user\n        decimal price_per_room\n        boolean is_trial\n        date trial_ends_at\n        date current_period_start\n        date next_billing_date\n    }\n\n    INVOICE {\n        uuid id PK\n        uuid tenant_id FK\n        uuid subscription_id FK\n        enum invoice_type\n        date period_start\n        date period_end\n        decimal amount\n        enum status\n        datetime issued_at\n        datetime paid_at\n        datetime first_failed_at\n        date grace_until\n    }\n\n    PRICING_CONFIG {\n        uuid id PK\n        decimal price_per_location\n        decimal price_per_user\n        decimal price_per_room\n        date effective_from\n        uuid updated_by FK\n    }\n\n    SYSTEM_CONFIG {\n        uuid id PK\n        int trial_days\n        int grace_period_days\n        uuid updated_by FK\n    }\n\n    LOCATION {\n        uuid id PK\n        uuid tenant_id FK\n        string name\n        string address\n        string phone\n        int star_rating\n        string timezone\n        enum status\n    }\n\n    DEPARTMENT {\n        uuid id PK\n        uuid tenant_id FK_UK\n        string name UK\n        boolean is_active\n    }\n\n    POSITION {\n        uuid id PK\n        uuid tenant_id FK_UK\n        uuid department_id FK\n        string name UK\n        enum position_type\n        boolean is_active\n    }\n\n    ROOM_TYPE {\n        uuid id PK\n        uuid tenant_id FK_UK\n        string name UK\n        boolean is_active\n    }\n\n    AREA {\n        uuid id PK\n        uuid tenant_id FK\n        uuid location_id FK_UK\n        string name UK\n    }\n\n    USER {\n        uuid id PK\n        uuid tenant_id FK\n        enum role\n        string email UK\n        string password_hash\n        boolean must_change_password\n        enum status\n        string full_name\n        string phone\n        uuid location_id FK\n        uuid position_id FK\n        date start_work_date\n        date date_of_birth\n        enum gender\n        string address\n        string avatar_url\n        datetime terminated_at\n        uuid terminated_by FK\n    }\n\n    SCHEDULE_POLICY {\n        uuid id PK\n        uuid tenant_id FK_UK\n        decimal max_hours_per_day\n        decimal max_hours_per_week\n        int max_consecutive_shifts\n        decimal min_rest_hours_between_shifts\n        int min_days_off_per_week\n        int swap_response_timeout_hours\n    }\n\n    SHIFT_TEMPLATE {\n        uuid id PK\n        uuid tenant_id FK\n        string name\n        time start_time\n        time end_time\n        string description\n        boolean is_active\n    }\n\n    SHIFT {\n        uuid id PK\n        uuid tenant_id FK\n        uuid location_id FK\n        uuid staff_id FK\n        date shift_date\n        time start_time\n        time end_time\n        boolean is_overnight\n        decimal duration_hours\n        uuid source_template_id FK\n        datetime check_in_at\n        datetime check_out_at\n        uuid created_by FK\n        enum unassigned_reason\n        datetime unassigned_at\n    }\n\n    LEAVE_REQUEST {\n        uuid id PK\n        uuid tenant_id FK\n        uuid location_id FK\n        uuid requester_id FK\n        date from_date\n        date to_date\n        string reason\n        enum status\n        uuid approver_id FK\n        datetime decided_at\n    }\n\n    SHIFT_SWAP_REQUEST {\n        uuid id PK\n        uuid tenant_id FK\n        uuid location_id FK\n        uuid requester_id FK\n        uuid requester_shift_id FK\n        uuid peer_id FK\n        uuid peer_shift_id FK\n        enum status\n        datetime peer_responded_at\n        datetime expires_at\n        uuid approver_id FK\n        datetime decided_at\n    }\n\n    TRANSFER_REQUEST {\n        uuid id PK\n        uuid tenant_id FK\n        uuid target_user_id FK\n        uuid from_location_id FK\n        uuid to_location_id FK\n        uuid replacement_manager_id FK\n        date effective_date\n        enum status\n        uuid requester_id FK\n        uuid approver_id FK\n    }\n\n    ROOM {\n        uuid id PK\n        uuid tenant_id FK\n        uuid location_id FK_UK\n        string room_number UK\n        string floor\n        uuid room_type_id FK\n        int capacity\n        string note\n        enum status\n        string unavailable_reason\n        boolean is_active\n        uuid created_by FK\n    }\n\n    ROOM_STATUS_HISTORY {\n        uuid id PK\n        uuid tenant_id FK\n        uuid room_id FK\n        enum from_status\n        enum to_status\n        uuid changed_by FK\n        datetime changed_at\n        enum change_source\n        string reason\n        uuid related_task_id FK\n    }\n\n    HOUSEKEEPING_TASK {\n        uuid id PK\n        uuid tenant_id FK\n        uuid location_id FK\n        uuid room_id FK\n        enum task_type\n        enum status\n        uuid assigned_staff_id FK\n        date assigned_date\n        uuid assigned_by FK\n        datetime assigned_at\n        datetime completed_at\n        enum created_source\n        uuid parent_task_id FK\n        enum unassigned_reason\n    }\n\n    INSPECTION_RECORD {\n        uuid id PK\n        uuid tenant_id FK\n        uuid task_id FK\n        uuid room_id FK\n        uuid inspector_id FK\n        enum result\n        string reason\n        datetime inspected_at\n        uuid next_task_id FK\n    }\n\n    ASSET_CATEGORY {\n        uuid id PK\n        uuid tenant_id FK_UK\n        string name UK\n        enum asset_kind\n        enum purpose\n        string unit\n        boolean is_active\n    }\n\n    FIXED_ASSET {\n        uuid id PK\n        uuid tenant_id FK\n        uuid location_id FK\n        uuid category_id FK\n        string asset_code UK\n        string name\n        uuid room_id FK\n        uuid area_id FK\n        enum status\n        string note\n        uuid created_by FK\n    }\n\n    CONSUMABLE_ITEM {\n        uuid id PK\n        uuid tenant_id FK\n        uuid location_id FK_UK\n        uuid category_id FK_UK\n        decimal quantity\n        datetime last_counted_at\n        uuid last_counted_by FK\n    }\n\n    DAMAGE_REPORT {\n        uuid id PK\n        uuid tenant_id FK\n        uuid location_id FK\n        uuid fixed_asset_id FK\n        uuid reporter_id FK\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="_kXVza8fc0YlQVwVZunb-15">
